# Copy to .env and fill in. Never commit .env.
SARVAM_API_KEY=
# Flagsmith server-side key (starts with "ser.") -> local evaluation, flips land in ~5s
FLAGSMITH_ENVIRONMENT_KEY=
# Only needed by ops/flagsmith_toggle.py (and NudgeBee's HTTP task)
FLAGSMITH_ADMIN_API_KEY=
FLAGSMITH_ENV_API_KEY=
# Leave empty for single instance; docker-compose / k8s set this
REDIS_URL=
# true = run fully offline with fake Sarvam responses
MOCK_MODE=false
SARVAM_MAX_CONCURRENCY=8
